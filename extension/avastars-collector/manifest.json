{
  "manifest_version": 3,
  "name": "AvaStars Collector",
  "version": "1.6.0",
  "description": "Send job applicants from Indeed, LinkedIn messages and other portals to AvaStars Hire.",
  "action": {
    "default_title": "AvaStars Collector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "downloads",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://*.indeed.com/*",
    "https://*.indeed.co.in/*",
    "https://*.naukri.com/*",
    "https://*.linkedin.com/*",
    "https://*.foundit.in/*",
    "https://*.shine.com/*",
    "https://*.apna.co/*",
    "https://*.workindia.in/*",
    "https://*.licdn.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "connect.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "linkedin.js"
      ],
      "css": [
        "linkedin.css"
      ],
      "run_at": "document_idle"
    }
  ]
}