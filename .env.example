# ---------- Core ----------
# Public URL of the app (used in links sent to candidates and clients)
APP_URL=http://localhost:3000
# Long random string used to sign login sessions (required in production)
AUTH_SECRET=change-me-to-a-long-random-string
# First admin user, created automatically when the database has no users
ADMIN_EMAIL=admin@avastars.local
ADMIN_PASSWORD=changeme123
# Secret for cron endpoints (/api/cron/*). Vercel Cron sends it as a Bearer token.
CRON_SECRET=change-me-too

# ---------- Database ----------
# Supabase / any Postgres connection string. Leave empty to use the built-in
# local database (PGlite, stored in ./.data/pglite) for development.
DATABASE_URL=
# Set to "false" for a local Postgres without SSL
DATABASE_SSL=true

# ---------- AI (resume reading, matching, JD drafts, call scoring) ----------
# Without a key the app falls back to simple keyword rules.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# ---------- Email (slot requests, client shortlists, interview invites) ----------
# Without SMTP settings, messages are only saved in the Outbox (Settings page).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AvaStars Recruitment <hr@avastars.in>"

# ---------- WhatsApp (optional) ----------
# Any WhatsApp Business provider: the app POSTs {to, text} as JSON to this URL.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=

# ---------- Careers inbox import (optional, IMAP) ----------
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# ---------- AI voice screening ----------
# mock    = no real calls; use "Simulate call" on the AI screening page
# bolna   = Bolna Voice AI (set BOLNA_* below)
# webhook = POST call requests to VOICE_DISPATCH_URL (e.g. an Omni / n8n flow)
VOICE_PROVIDER=mock
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=
BOLNA_API_URL=https://api.bolna.ai
VOICE_DISPATCH_URL=
# Shared secret the voice platform must send back on webhooks (?secret=...)
VOICE_WEBHOOK_SECRET=change-me-as-well

# ---------- LinkedIn posting (optional) ----------
# Free LinkedIn developer app (linkedin.com/developers) with the products
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn".
# Add this redirect URL in the app's Auth tab: <APP_URL>/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn API version (YYYYMM). Versions retire after about a year; bump if posting starts failing.
LINKEDIN_API_VERSION=202608
